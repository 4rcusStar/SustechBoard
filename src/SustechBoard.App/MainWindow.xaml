<Window x:Class="SustechBoard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SustechBoard.App"
        Title="SustechBoard"
        Width="392" Height="560"
        MinWidth="320" MinHeight="300"
        MaxWidth="1200" MaxHeight="1600"
        WindowStyle="None" AllowsTransparency="False" Background="#14161C"
        ShowInTaskbar="False" ResizeMode="CanResize"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True"
        UseLayoutRounding="True" FontFamily="Microsoft YaHei UI, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:LinesByWidthConverter x:Key="TitleLines" LineHeight="17"
                                     NarrowLines="2" MidLines="2" WideLines="3"/>
        <local:LinesByWidthConverter x:Key="SummaryLines" LineHeight="15"
                                     NarrowLines="1" MidLines="2" WideLines="4"/>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="12" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource Line}" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== header ===== -->
            <Grid Grid.Row="0" Margin="14,12,10,8" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SustechBoard" Foreground="{StaticResource TextPrimary}"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}"
                               FontSize="10.5" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="LockButton" Style="{StaticResource IconButton}" Content="🔓"
                            FontSize="12" ToolTip="锁定：沉到桌面最底部并禁用交互"
                            Click="Lock_Click"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="⟳"
                            FontSize="15" ToolTip="立即刷新" Click="Refresh_Click"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="⚙"
                            FontSize="13" ToolTip="设置" Click="Settings_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="✕"
                            FontSize="12" ToolTip="隐藏到托盘" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== tabs ===== -->
            <WrapPanel x:Name="TabPanel" Grid.Row="1" Orientation="Horizontal" Margin="14,0,14,3">
                <RadioButton x:Name="TabTodo" Style="{StaticResource TabButton}" Content="待办"
                             IsChecked="True" GroupName="Tabs" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabCalendar" Style="{StaticResource TabButton}" Content="日程表"
                             GroupName="Tabs" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabAll" Style="{StaticResource TabButton}" Content="全部"
                             GroupName="Tabs" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabManual" Style="{StaticResource TabButton}" Content="手动归档"
                             GroupName="Tabs" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabExpired" Style="{StaticResource TabButton}" Content="过期归档"
                             GroupName="Tabs" Checked="Tab_Checked"/>
            </WrapPanel>

            <!-- ===== content ===== -->
            <Grid x:Name="ContentHost" Grid.Row="2" Margin="14,0,14,0">

                <!-- list -->
                <Grid x:Name="ListPane">
                    <ListBox x:Name="ItemList"
                             ItemsSource="{Binding Items}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource CardItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"
                             KeyboardNavigation.TabNavigation="None">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ItemVm}">
                                <Grid MouseLeftButtonUp="Row_Click">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="3" CornerRadius="2"
                                            Background="{Binding BadgeBrush}" Margin="0,2,8,2"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="12.5" LineHeight="17"
                                                   MaxHeight="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TitleLines}}"/>
                                        <TextBlock Text="{Binding Course}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10.5" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="10.5" LineHeight="15"
                                                   MaxHeight="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SummaryLines}}"
                                                   Margin="0,3,0,0"/>
                                        <Button Content="{Binding ArchiveButtonText}"
                                                Style="{StaticResource MiniButton}"
                                                Visibility="{Binding ArchiveButtonVisibility}"
                                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                                ToolTip="归档后可在「手动归档」中还原"
                                                Click="Archive_Click"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <Border Background="{Binding LabelBgBrush}" CornerRadius="4"
                                                Padding="6,1" HorizontalAlignment="Right"
                                                Margin="0,0,0,4">
                                            <TextBlock Text="{Binding LabelText}" FontSize="9.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding LabelBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding DeadlineText}" FontSize="10.5"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Foreground="{Binding DeadlineBrush}"/>
                                        <TextBlock Text="{Binding BadgeText}" FontSize="9.5"
                                                   HorizontalAlignment="Right" Margin="0,2,0,0"
                                                   Foreground="{Binding BadgeBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyHint" Text="{Binding EmptyText}" IsHitTestVisible="False"
                               Foreground="{StaticResource TextMuted}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>

                <!-- calendar -->
                <Grid x:Name="CalendarPane" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="‹" Style="{StaticResource IconButton}"
                                FontSize="15" Click="CalPrev_Click"/>
                        <TextBlock Grid.Column="1" Text="{Binding MonthText}"
                                   Foreground="{StaticResource TextPrimary}" FontSize="12.5"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="今天" Style="{StaticResource MiniButton}"
                                VerticalAlignment="Center" Margin="0,0,4,0" Click="CalToday_Click"/>
                        <Button Grid.Column="3" Content="›" Style="{StaticResource IconButton}"
                                FontSize="15" Click="CalNext_Click"/>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,1">
                        <TextBlock Text="一" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        <TextBlock Text="二" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        <TextBlock Text="三" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        <TextBlock Text="四" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        <TextBlock Text="五" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        <TextBlock Text="六" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        <TextBlock Text="日" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                    </UniformGrid>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}" Margin="0,2,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CalendarDayVm}">
                                <Border Background="{Binding Background}" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="{Binding CellBorder}"
                                        Height="42" Margin="1" Cursor="Hand"
                                        MouseLeftButtonUp="Day_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DayText}" HorizontalAlignment="Center"
                                                   FontSize="11" Foreground="{Binding Foreground}"
                                                   FontWeight="{Binding FontWeight}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    Margin="0,3,0,0">
                                            <Ellipse Width="4" Height="4" Margin="1,0"
                                                     Fill="{Binding Dot1}" Visibility="{Binding Dot1Visibility}"/>
                                            <Ellipse Width="4" Height="4" Margin="1,0"
                                                     Fill="{Binding Dot2}" Visibility="{Binding Dot2Visibility}"/>
                                            <Ellipse Width="4" Height="4" Margin="1,0"
                                                     Fill="{Binding Dot3}" Visibility="{Binding Dot3Visibility}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <TextBlock Text="{Binding SelectedDateText}" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding SelectedCountText}" HorizontalAlignment="Right"
                                       FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding SelectedEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:CalendarEventVm}">
                                            <Border Background="{StaticResource BgCard}" CornerRadius="6"
                                                    Padding="8,6" Margin="0,0,3,5"
                                                    BorderThickness="1" BorderBrush="{StaticResource Line}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="4" Padding="5,1"
                                                            VerticalAlignment="Top" Background="#1E2430">
                                                        <TextBlock Text="{Binding KindLabel}" FontSize="9.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding KindBrush}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,6,0">
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   FontSize="11.5" MaxHeight="32"/>
                                                        <TextBlock Text="{Binding Course}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   FontSize="10" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               FontSize="10.5" FontWeight="SemiBold"
                                                               VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="无事件" FontSize="11" Margin="0,18,0,0"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedEvents}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- detail -->
                <Grid x:Name="DetailPane" Visibility="Collapsed" Background="{StaticResource BgPanel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                        <Button Content="← 返回列表" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Left" Click="Back_Click"/>
                        <TextBlock x:Name="DTitle" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="13.5" FontWeight="SemiBold" LineHeight="19"/>
                        <TextBlock x:Name="DMeta" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMuted}" FontSize="10.5"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,6,0">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <Border x:Name="DDeadlineBox" Background="{StaticResource BgCard}"
                                    CornerRadius="6" Padding="9,7" BorderThickness="1"
                                    BorderBrush="{StaticResource Line}" Margin="0,0,4,8">
                                <TextBlock x:Name="DDeadline" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimary}" FontSize="11.5"/>
                            </Border>

                            <TextBlock x:Name="DAction" TextWrapping="Wrap" Margin="0,0,4,6"
                                       Foreground="{StaticResource Accent}" FontSize="11.5"/>

                            <TextBlock x:Name="DConstraints" TextWrapping="Wrap" Margin="0,0,4,8"
                                       Foreground="{StaticResource P1Brush}" FontSize="11"/>

                            <TextBlock x:Name="DBody" TextWrapping="Wrap" Margin="0,0,8,10"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11.5" LineHeight="18"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,10">
                        <Button Content="在 Blackboard 打开" Style="{StaticResource PrimaryButton}"
                                Click="OpenBb_Click"/>
                        <TextBlock x:Name="DSource" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextMuted}" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===== footer ===== -->
            <Grid x:Name="FooterBar" Grid.Row="3" Margin="14,4,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="{Binding Status}"
                           Foreground="{StaticResource TextMuted}" FontSize="10.5"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock x:Name="SyncText" Grid.Column="1" Foreground="{StaticResource TextMuted}"
                           FontSize="10.5" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
