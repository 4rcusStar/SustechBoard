<Window x:Class="SustechBoard.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="432" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderThickness="1" BorderBrush="{StaticResource Line}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderThickness="1" BorderBrush="{StaticResource Line}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="15" Height="15" CornerRadius="3"
                                    Background="{StaticResource BgCard}" BorderThickness="1"
                                    BorderBrush="{StaticResource Line}" VerticalAlignment="Center">
                                <TextBlock x:Name="tick" Text="✓" FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,2"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,14,12,6" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="设置" Foreground="{StaticResource TextPrimary}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="✕" Style="{StaticResource IconButton}" FontSize="12"
                        HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="18,0,14,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel Margin="0,0,6,10">

                    <TextBlock Text="账号与登录" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="学号（SID）" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UserBox" Style="{StaticResource FieldBox}"/>

                    <TextBlock Text="密码（原样保存，区分大小写与末尾符号）" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource FieldPassword}"/>
                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10"
                               Margin="0,5,0,0" TextWrapping="Wrap"
                               Text="密码用 Windows DPAPI 加密后存于本机，不会明文落盘、不会上传。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="TestButton" Content="测试登录" Style="{StaticResource GhostButton}"
                                Click="Test_Click"/>
                        <TextBlock x:Name="TestStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                                   FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>

                    <TextBlock Text="刷新策略" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="刷新间隔（分钟）" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="IntervalBox" Style="{StaticResource FieldBox}"
                             Width="110" HorizontalAlignment="Left"/>

                    <CheckBox x:Name="DayOnlyCheck" Content="仅在白天时段刷新"
                              Style="{StaticResource DarkCheck}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="从" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="StartHourBox" Style="{StaticResource FieldBox}" Width="64"
                                 Height="34" HorizontalAlignment="Left" Margin="8,0,8,0"
                                 TextAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                        <TextBlock Text="点到" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="EndHourBox" Style="{StaticResource FieldBox}" Width="64"
                                 Height="34" HorizontalAlignment="Left" Margin="8,0,8,0"
                                 TextAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                        <TextBlock Text="点" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="通知" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="DesktopNotifyCheck" Content="桌面通知（新公告 / 临近截止）"
                              Style="{StaticResource DarkCheck}"/>
                    <CheckBox x:Name="WebhookCheck" Content="推送到企业微信 / webhook"
                              Style="{StaticResource DarkCheck}"/>
                    <TextBox x:Name="WebhookBox" Style="{StaticResource FieldBox}" Margin="0,8,0,0"/>
                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Text="填企业微信群机器人地址（qyapi.weixin.qq.com/…），或任意接收 JSON 的地址。"/>

                    <TextBlock Text="大模型智能分析" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="LlmCheck" Content="启用语义分析（OpenAI 兼容接口）"
                              Style="{StaticResource DarkCheck}"/>
                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Text="关闭或未填 Key 时自动使用规则分析。启用后公告正文会发送到你指定的模型服务。"/>

                    <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="LlmBaseBox" Style="{StaticResource FieldBox}"/>
                    <TextBlock Text="模型名" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="LlmModelBox" Style="{StaticResource FieldBox}"/>
                    <TextBlock Text="API Key" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="LlmKeyBox" Style="{StaticResource FieldPassword}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="TestLlmButton" Content="测试模型"
                                Style="{StaticResource GhostButton}" Click="TestLlm_Click"/>
                        <TextBlock x:Name="LlmTestStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                                   FontSize="11" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" MaxWidth="250"/>
                    </StackPanel>

                    <TextBlock Text="显示" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10"
                               Margin="0,3,0,2" TextWrapping="Wrap"
                               Text="面板可拖拽边框缩放，界面会自动适应宽度。"/>
                    <RadioButton x:Name="DispFocusTop" GroupName="Disp"
                                 Style="{StaticResource DarkRadio}"
                                 Content="仅 focus 的时候在最上"/>
                    <RadioButton x:Name="DispAlwaysBottom" GroupName="Disp"
                                 Style="{StaticResource DarkRadio}"
                                 Content="随时在最下层"/>

                    <TextBlock Text="系统" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="StartupCheck" Content="开机自动启动（最小化到托盘）"
                              Style="{StaticResource DarkCheck}"/>

                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,14,0,0"
                               TextWrapping="Wrap">
                        数据位置：%LOCALAPPDATA%\SustechBoard
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="18,8,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="取消" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="保存" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
